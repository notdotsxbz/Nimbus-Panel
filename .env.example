# ─────────────────────────────────────────────────────────────
# NIMBUS Hosting Panel — Environment Configuration (EXAMPLE)
# Copy to .env and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────
NODE_ENV=production
PANEL_DOMAIN=panel.nimbushost.com
HOSTING_DOMAIN=nimbushost.com
API_PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/nimbus

# ── Auth / Sessions ───────────────────────────────────────────
# Generate with: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
# Bootstrap admin (forced to change credentials on first login)
BOOTSTRAP_ADMIN_EMAIL=admin@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=admin

# ── Firebase Authentication (client + server) ─────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Base64 of the Firebase Admin SDK service-account JSON
FIREBASE_ADMIN_CREDENTIALS_BASE64=

# ── Node Agent security ───────────────────────────────────────
# Shared secret used to sign agent enrollment + heartbeat JWTs
AGENT_SHARED_SECRET=change-me-agent-secret
AGENT_ENROLLMENT_TOKEN_TTL_MINUTES=30

# ── Redis / BullMQ (background jobs) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ── Cloudflare (scoped API token — DNS edit only) ─────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── Google Drive backups (OAuth) ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# AES key used to encrypt OAuth refresh tokens at rest (hex, 64 chars)
BACKUP_TOKEN_ENCRYPTION_KEY=

# ── Networking / allocations ─────────────────────────────────
DEFAULT_PORT_RANGE_START=4001
DEFAULT_PORT_RANGE_END=4050

# ── Security ──────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
