{
  "$schema": "../module.schema.json",
  "name": "minecraft",
  "label": "Minecraft Hosting",
  "subdomainPattern": "play-{username}",
  "requiresPort": true,
  "protocols": ["tcp"],
  "software": [
    { "id": "vanilla",  "label": "Vanilla",  "image": "ghcr.io/pterodactyl/yolks:java_21", "versions": ["1.21", "1.20.4"], "minRamMb": 1024 },
    { "id": "paper",    "label": "Paper",    "image": "ghcr.io/pterodactyl/yolks:java_21", "versions": ["1.21", "1.20.4"], "minRamMb": 2048 },
    { "id": "purpur",   "label": "Purpur",   "image": "ghcr.io/pterodactyl/yolks:java_21", "versions": ["1.21", "1.20.4"], "minRamMb": 2048 },
    { "id": "spigot",   "label": "Spigot",   "image": "ghcr.io/pterodactyl/yolks:java_17", "versions": ["1.20.4"], "minRamMb": 1024 },
    { "id": "fabric",   "label": "Fabric",   "image": "ghcr.io/pterodactyl/yolks:java_21", "versions": ["1.21"], "minRamMb": 2048 },
    { "id": "forge",    "label": "Forge",    "image": "ghcr.io/pterodactyl/yolks:java_17", "versions": ["1.20.4"], "minRamMb": 3072 },
    { "id": "neoforge", "label": "NeoForge", "image": "ghcr.io/pterodactyl/yolks:java_21", "versions": ["1.21"], "minRamMb": 3072 },
    { "id": "folia",    "label": "Folia",    "image": "ghcr.io/pterodactyl/yolks:java_21", "versions": ["1.21"], "minRamMb": 4096 }
  ],
  "features": ["console", "files", "plugins", "worlds", "players", "whitelist", "backups", "scheduled-commands", "srv-routing"],
  "notes": "Minecraft needs an A record (+ optional SRV). HTTPS certificates do not secure raw TCP game traffic."
}
